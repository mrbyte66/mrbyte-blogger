# Only placeholders. Copy outside Git and generate distinct secrets.
DB_URL=jdbc:postgresql://127.0.0.1:5433/satir
DB_USER=satir
DB_PASSWORD=<generate-local-database-password>
RATE_HMAC_SECRET=<generate-at-least-32-random-characters>
TOKEN_ENCRYPTION_KEY=<base64-encoded-32-random-bytes>
PUBLIC_SITE_ORIGIN=http://localhost:3000
APP_TIME_ZONE=Europe/Istanbul
SESSION_COOKIE_NAME=satir-session-dev
COOKIE_SECURE=false
MIGRATION_MODE=validate
INDEXING_ENABLED=false
# Mailpit receives real development mail; this is not production SMTP.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=<development-sender-email>
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TLS_REQUIRED=false

# Private directory outside Next public/ and outside the reverse proxy web root.
MEDIA_ROOT=./var/media

# Optional Google OIDC; register PUBLIC_ORIGIN/api/v1/auth/google/callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domain export/import files are private and expire after 24 hours.
ARCHIVE_ROOT=./var/archives
# Optional cover provider; leave none until credentials/licensing are configured.
COVER_PROVIDER=none
PEXELS_API_KEY=
