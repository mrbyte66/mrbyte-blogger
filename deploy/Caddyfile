{$PUBLIC_HOST} {
    encode zstd gzip
    request_body {
        max_size 102MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=86400"
        # Next renders inline theme bootstrap and JSON-LD. A nonce CSP is a release gate.
        Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        -Server
    }
    @internal path /actuator/* /api/v1/actuator/*
    respond @internal 404
    handle /api/* {
        reverse_proxy backend:8080 {
            header_up -Forwarded
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {$PUBLIC_HOST}
        }
    }
    handle {
        reverse_proxy frontend:3000
        header Cache-Control "private, no-store"
    }
}
# Only an explicitly configured alias is redirected; arbitrary Host is never canonical.
{$ALIAS_HOST} {
    redir https://{$PUBLIC_HOST}{uri} 308
}
