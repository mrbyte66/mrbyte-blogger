# Production references must include @sha256:... (no floating tags).
PUBLIC_HOST=example.invalid
ALIAS_HOST=www.example.invalid
SECRETS_DIR=/etc/satir/secrets
BACKEND_IMAGE=<registry/backend@sha256:verified-digest>
FRONTEND_IMAGE=<registry/frontend@sha256:verified-digest>
POSTGRES_IMAGE=<postgres:18@sha256:verified-digest>
CADDY_IMAGE=<caddy:2@sha256:verified-digest>
DB_NAME=satir
INDEXING_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=
MAIL_USERNAME=
GOOGLE_CLIENT_ID=

COVER_PROVIDER=none
# Private secret file pexels-key may be empty when provider is none.
