# Variable names only. Copy to deploy/.env (git-ignored) or provide via the host's secret store.
# Never commit real values. Owner bootstrap passwords are NOT configured here (stdin/secret file only).

# --- Local development (compose.dev.yml) ---
DEV_DB_PASSWORD=
DEV_DB_PORT=5432

# --- Public site ---
# Trusted canonical origin used for canonical URLs, sitemap and links in e-mails (never the Host header).
PUBLIC_SITE_ORIGIN=https://example.com
# Deployment indexing gate. Search indexing needs this AND the owner's Studio site setting.
INDEXING_ENABLED=false
APP_TIME_ZONE=Europe/Istanbul

# --- Backend runtime ---
SPRING_PROFILES_ACTIVE=
DB_HOST=
DB_PORT=5432
DB_NAME=satir
DB_USER=
# Secret: prefer a mounted secret file over a plain environment variable in production.
DB_PASSWORD=
DB_POOL_SIZE=8
# Secret, >= 32 random characters: HMAC key for abuse buckets, session handles and e-mail-change encryption.
SATIR_RATE_LIMIT_KEY=
# Private media volume (outside any web root).
SATIR_MEDIA_ROOT=/var/lib/satir/media
# Argon2id cost; tune on the VPS towards ~200-500 ms per verification.
SATIR_SECURITY_ARGON2_MEMORY_KIB=19456
SATIR_SECURITY_ARGON2_ITERATIONS=2
SATIR_SECURITY_ARGON2_PARALLELISM=1

# --- E-mail (SMTP). Unset host = mail reported as unavailable, never faked ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
# Secret
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SATIR_MAIL_FROM=

# --- Google sign-in (optional; unset = "not configured" in the UI) ---
SATIR_GOOGLE_CLIENT_ID=
# Secret
SATIR_GOOGLE_CLIENT_SECRET=
# Defaults to ${PUBLIC_SITE_ORIGIN}/api/v1/auth/google/callback; register exactly this URI at Google.
SATIR_GOOGLE_REDIRECT_URI=

# --- Licensed cover search (optional; unset = provider unavailable) ---
# Secret
SATIR_COVERS_PEXELS_API_KEY=

# --- Frontend (Next.js) ---
# Internal backend origin for server rendering and the /api rewrite (never exposed to browsers).
BACKEND_INTERNAL_URL=http://backend:8080

# --- Backend tests without Docker (optional; disposable database only) ---
SATIR_TEST_JDBC_URL=
SATIR_TEST_DB_USER=
SATIR_TEST_DB_PASSWORD=
