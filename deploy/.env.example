# Variable names only. Never commit real values.
#  - Local development: copy to deploy/.env (git-ignored).
#  - Production: /etc/satir/release.env (non-secret config + image digests) for compose.prod.yml.
# Secrets are NOT set here in production: they are files in SATIR_SECRETS_DIR (see runbooks/first-deploy.md).
# Owner bootstrap passwords are never configured here (stdin/secret file only).

# --- Local development (compose.dev.yml) ---
DEV_DB_PASSWORD=
DEV_DB_PORT=5432

# --- Release (compose.prod.yml): immutable image references from the Images workflow's release manifest,
#     e.g. ghcr.io/mrbyte66/satir-backend@sha256:... (never :main or :latest) ---
APP_RELEASE=
BACKEND_IMAGE=
FRONTEND_IMAGE=
POSTGRES_IMAGE=postgres:18.4
CADDY_IMAGE=caddy:2.11.7
RESTIC_IMAGE=restic/restic:0.19.1
# Directory with one file per secret (0444 files inside a 0700 root-owned directory).
SATIR_SECRETS_DIR=/etc/satir/secrets

# --- Public site / edge ---
# Trusted canonical origin used for canonical URLs, sitemap and links in e-mails (never the Host header).
PUBLIC_SITE_ORIGIN=https://example.com
# Canonical host and the alternative host that is redirected to it (308).
SITE_HOST=example.com
SITE_ALT_HOST=www.example.com
# Contact address for the TLS certificate authority (ACME).
ACME_EMAIL=
# Deployment indexing gate. Search indexing needs this AND the owner's Studio site setting.
INDEXING_ENABLED=false
APP_TIME_ZONE=Europe/Istanbul

# --- Backend runtime ---
SPRING_PROFILES_ACTIVE=
DB_HOST=
DB_PORT=5432
DB_NAME=satir
DB_USER=
# Secret: in production the DB_PASSWORD file under SATIR_SECRETS_DIR (db_app_password).
DB_PASSWORD=
DB_POOL_SIZE=8
# Secret, >= 32 random characters: HMAC key for abuse buckets, view dedupe, session handles and
# e-mail-change encryption. Production: rate_limit_key secret file.
SATIR_RATE_LIMIT_KEY=
# Private media volume (outside any web root).
SATIR_MEDIA_ROOT=/var/lib/satir/media
# Argon2id cost; tune on the VPS towards ~200-500 ms per verification.
SATIR_SECURITY_ARGON2_MEMORY_KIB=19456
SATIR_SECURITY_ARGON2_ITERATIONS=2
SATIR_SECURITY_ARGON2_PARALLELISM=1

# --- E-mail (SMTP). Unset host = mail reported as unavailable, never faked ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
# Secret (production: mail_password secret file)
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SATIR_MAIL_FROM=

# --- Google sign-in (optional; unset = "not configured" in the UI) ---
SATIR_GOOGLE_CLIENT_ID=
# Secret (production: google_client_secret secret file)
SATIR_GOOGLE_CLIENT_SECRET=
# Defaults to ${PUBLIC_SITE_ORIGIN}/api/v1/auth/google/callback; register exactly this URI at Google.
SATIR_GOOGLE_REDIRECT_URI=

# --- Licensed cover search (optional; unset = provider unavailable) ---
# Secret (production: pexels_api_key secret file)
SATIR_COVERS_PEXELS_API_KEY=

# --- Frontend (Next.js) ---
# Internal backend origin for server rendering and the /api rewrite (never exposed to browsers).
BACKEND_INTERNAL_URL=http://backend:8080

# --- Backend tests without Docker (optional; disposable database only) ---
SATIR_TEST_JDBC_URL=
SATIR_TEST_DB_USER=
SATIR_TEST_DB_PASSWORD=
